# Copia este archivo como .env.local y rellena los valores. Ninguna clave
# real va en el repo — .env* está en .gitignore.

# ── Supabase (proyecto dedicado a este dashboard SaaS, ver database/saas-schema.sql) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role — Settings > API en el proyecto Supabase. Nunca al navegador:
# solo la lee src/lib/supabase/admin.ts, usado exclusivamente por el
# webhook de Stripe para escribir clients/client_users saltándose RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (modo Test primero) ──
# Developers > API keys — Secret key.
STRIPE_SECRET_KEY=
# Developers > API keys — Publishable key. Esta SÍ va al navegador (monta el
# Payment Element embebido en /precios/[plan]/pagar) — no es sensible.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers > Webhooks > tu endpoint > Signing secret.
STRIPE_WEBHOOK_SECRET=
# Price ID (price_...) de cada producto — Product catalog.
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ULTRA=

# ── Resend (formulario de /contacto) ──
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
